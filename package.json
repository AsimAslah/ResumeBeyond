{
  "name": "resumebeyond",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "start": "node server.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:privacy": "node scripts/privacy-scan.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "verify:deployed": "node scripts/verify-deployment.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:privacy && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}

